{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": false
  },
  "env": {
    "DO_NOT_TRACK": "1",
    "EXPO_SKILLS_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(bun run verify)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run test *)",
      "Bash(bun run test)",
      "Bash(bunx expo lint *)",
      "Bash(bunx tsc --noEmit)",
      "Bash(bunx expo-doctor)",
      "Bash(bash .claude/hooks/test-hooks.sh)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-files.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-changed.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
