EXPO_PUBLIC_API_URL=https://api.example.com
# Optional: crash reporting is a no-op until set.
EXPO_PUBLIC_SENTRY_DSN=
# Optional until your first EAS build or update: your EAS project id (printed by `bun run eas init`). Public, not a
# secret; app.config.ts puts it in extra.eas.projectId and updates.url. Expo CLI reads it from .env; also set it in your
# shell (each terminal, or your shell profile) for `bun run eas ...` (docs/setup.md step 4).
EAS_PROJECT_ID=
# Feature flags: literal EXPO_PUBLIC_FLAG_* vars, read in src/config/flags.ts (true/false or 1/0).
EXPO_PUBLIC_FLAG_EXAMPLE=false
