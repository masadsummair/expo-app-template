  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "sonner-native": "0.27.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "1.12.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.72",
    "@ai-sdk/google": "4.0.88",
    "@ai-sdk/openai": "4.0.84",
    "@ai-sdk/openai-compatible": "3.0.63",
    "@ai-sdk/xai": "5.0.15",
    "@e2e-dev/mobile": "0.9.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/bun": "1.4.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "ai": "7.0.128",
    "e2e": "0.17.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-atlas": "0.4.3",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.ts",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "eas": "bunx eas-cli@24.11.0",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "jest",
    "test:hooks": "bun test ./.claude/hooks",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "test:e2e:android": "adb reverse tcp:8081 tcp:8081 && E2E_TELEMETRY_DISABLED=1 e2e run --target android",
    "test:e2e:ios": "E2E_TELEMETRY_DISABLED=1 e2e run --target ios",
    "test:e2e:list": "E2E_TELEMETRY_DISABLED=1 e2e list",
    "doctor": "expo-doctor",
    "lint:claude": "bun scripts/lint-claude.ts",
    "docs:check": "bun scripts/check-docs.ts",
    "contrast:check": "bun scripts/check-contrast.ts",
    "privacy:check": "bun scripts/check-privacy-manifest.ts",
    "rename": "bun scripts/rename.ts",
    "skills:sync": "bun scripts/sync-agent-skills.ts",
    "skills:check": "bun scripts/sync-agent-skills.ts --check",
    "specs:check": "bun scripts/check-ac-coverage.ts",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run test:hooks && bun run lint:claude && bun run docs:check && bun run skills:check && bun run contrast:check && bun run privacy:check"
  },
  "private": true,
  "trustedDependencies": [
    "@sentry/cli"
  ],
  "engines": {
    "bun": ">=1.3.7",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.7"
}
